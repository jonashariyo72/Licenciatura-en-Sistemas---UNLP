/* 1. Listar las mascotas que recibieron la vacuna "Triple Felina" con costo menor a 
$10.000 al momento de la aplicación */

SELECT m.nombre
FROM Mascota m 
INNER JOIN Aplicación_Vacuna a ON (m.id_mascota = a.id_mascota)
WHERE (nombreV) = "Triple Felina" AND (precio) < '10.000'


/* 2. Listar los datos de las mascotas que no se atendieron durante el año actual */

SELECT m.nombre, especie, raza, f_nac, dni_cliente
FROM Mascota m 
WHERE NOT EXISTS (
    SELECT 1 
    FROM Consulta c 
    WHERE m.id_mascota = c.id_mascota AND (YEAR(fecha)) = '2025'
)
AND NOT EXISTS (
    SELECT 1 
    FROM Aplicación_Vacuna a 
    WHERE m.id_mascota = a.id_mascota AND (YEAR(fecha_aplicacion)) = '2025'
)


/* 3. Listar nombre, apellido, telefono y cantidad de mascotas de los clientes que tienen más de 2 mascotas
registradas. Ordenar por cantidad de mascotas descendientes. */

SELECT c.nombre, apellido, telefono, COUNT(DISTINCT m.id_mascota) as cantMascotas
FROM Cliente c 
INNER JOIN Mascota m ON (c.dni = m.dni_cliente)
GROUP BY c.dni, c.nombre, apellido, telefono
HAVING COUNT(m.id_mascota) > 2
ORDER BY cantMascotas DESC

/* 4. Listar los datos de las que se obtuvieron el diagnostico "rabia" y además nunca se aplicó
la vacuna con nombre "Antirrábica" */

SELECT m.nombre, especie, raza, f_nac, dni_cliente
FROM Mascota m 
INNER JOIN Consulta c ON (m.id_mascota = c.id_mascota)
WHERE (diagnostico) = 'rabia'
AND NOT EXISTS (
    SELECT 1
    FROM Aplicación_Vacuna a 
    WHERE (m.id_mascota = a.id_mascota) AND (nombreV) = 'Antirrabica'
)